# SwarmKit Doxygen configuration.
#
# Run from the docs directory:
#   doxygen Doxyfile

PROJECT_NAME           = "SwarmKit"
PROJECT_BRIEF          = "C++23 SDK, agent, and CLI for multi-agent UAV control and telemetry"
OUTPUT_DIRECTORY       = build/doxygen

INPUT                  = ../include \
                         ../apps/test_tools \
                         ../README.md

FILE_PATTERNS          = *.h \
                         *.cpp \
                         *.md

RECURSIVE              = YES
EXCLUDE                = ../third_party \
                         ../build \
                         ../dist
EXCLUDE_PATTERNS       = */.DS_Store \
                         *.in

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

CREATE_SUBDIRS         = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ..
STRIP_FROM_INC_PATH    = ../include

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INLINE_INHERITED_MEMB  = YES
INHERIT_DOCS           = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES

GENERATE_TREEVIEW      = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

QUIET                  = NO
