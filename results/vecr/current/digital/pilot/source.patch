-def wilson(n, total):
-    if not total:
-        return (None, None)
-    z = 1.959963984540054
-    p = n / total
-    d = 1 + z * z / total
-    c = (p + z * z / (2 * total)) / d
-    h = z * math.sqrt(p * (1 - p) / total + z * z / (4 * total * total)) / d
-    return (0.0 if n == 0 else max(0, c - h)), (1.0 if n == total else min(1, c + h))
