-// Deterministic, intentionally simple strip-survey experiment. Truth is private
-// to Trial and is never passed to EdgeExecutionSupervisor.
-#include <array>
-#include <cmath>
-#include <cstdint>
-#include <filesystem>
-#include <fstream>
