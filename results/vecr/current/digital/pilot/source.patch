-def wilson(k, n):
-    if n == 0:
-        return (math.nan, math.nan)
-    z = 1.959963984540054
-    p = k / n
-    divisor = 1 + z * z / n
-    center = (p + z * z / (2 * n)) / divisor
-    radius = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / divisor
-    return center - radius, center + radius
