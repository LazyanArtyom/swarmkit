-def quantile(values, probability):
-    if not values:
-        return math.nan
-    ordered = sorted(values)
-    position = (len(ordered) - 1) * probability
-    left = int(position)
-    return ordered[left] * (1 - position + left) + ordered[min(left + 1, len(ordered) - 1)] * (position - left)
